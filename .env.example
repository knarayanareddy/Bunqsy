# .env.example

# bunq environment: "sandbox" | "production"
BUNQ_ENV=sandbox

# bunq API credentials
BUNQ_API_KEY=
BUNQ_DEVICE_DESCRIPTION=BunqsyFinance-Dev

# bunq sandbox base URL
BUNQ_SANDBOX_URL=https://public-api.sandbox.bunq.com/v1
BUNQ_PRODUCTION_URL=https://api.bunq.com/v1

# bunq offline fallback (set to true to run on seed data when sandbox is down)
# BUNQ_OFFLINE_MODE=false

# Anthropic
ANTHROPIC_API_KEY=

# Ollama (local embeddings)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ElevenLabs (STT + TTS)
ELEVENLABS_API_KEY=
# Optional: override the TTS voice (default: Sarah — EXAVITQu4vr4xnSDxMaL)
ELEVENLABS_VOICE_ID=

# Database
DB_PATH=./bunqsy.db

# ─── Server & security ────────────────────────────────────────────────────────
PORT=3001
WS_PORT=3002
HEARTBEAT_INTERVAL_MS=30000

# Interface to bind. Loopback by default: this process holds a bank session key
# and can move money. Only change it if the port is firewalled and you have set
# BUNQSY_API_TOKEN below.
# HOST=127.0.0.1

# Shared API token. Leave blank for local development and the daemon generates
# .bunqsy-token (0600) on first boot; the Vite dev proxy reads the same file and
# injects the header, so the browser never holds the secret. Set it explicitly
# for any deployment where the frontend is not served by that proxy.
BUNQSY_API_TOKEN=
# BUNQSY_TOKEN_FILE=/run/secrets/bunqsy-token

# Browser origins allowed to call the API (comma-separated, exact scheme+host+port).
# A leading dot matches subdomains: .example.com
# Localhost dev origins are implied unless BUNQ_ENV=production, which requires
# this to be set explicitly.
# ALLOWED_ORIGINS=https://dashboard.example.com

# Only enable behind a reverse proxy you control — it makes X-Forwarded-For
# authoritative, which the bunq webhook IP allow-list depends on.
# TRUST_PROXY=false

# Ceiling for any single agent-planned transfer, in EUR.
MAX_PAYMENT_EUR=500

# Outbound payments planned from speech are denied by default: the planner's
# only input is a transcript, which is the one channel an attacker can write to.
# Set to true to demo the "send €20 to Sarah" voice flow.
VOICE_PAYMENTS_ENABLED=false

# Enforce bunq webhook signatures outside production (always enforced in it).
# WEBHOOK_REQUIRE_SIGNATURE=true

# Spoken instructions contain names, amounts and IBANs — off by default.
# LOG_TRANSCRIPTS=false
# LOG_LEVEL=warn

# Webhook push URL — set to your public HTTPS base URL (ngrok or prod domain).
# When set, the daemon registers PAYMENT + MUTATION notification filters with bunq
# on startup so payments trigger instant heartbeat ticks instead of waiting for polling.
# Example: WEBHOOK_PUBLIC_URL=https://abc123.ngrok.io
WEBHOOK_PUBLIC_URL=

# BUNQSY Score weights (tune as needed)
SCORE_WEIGHT_BALANCE=0.35
SCORE_WEIGHT_VELOCITY=0.25
SCORE_WEIGHT_GOALS=0.25
SCORE_WEIGHT_UPCOMING=0.15


# ─── Bookkeeping ──────────────────────────────────────────────────────────────
BOOKKEEPING_AUTO_CATEGORIZE=true
REVIEW_THRESHOLD_AMOUNT_CENTS=50000
LLM_CATEGORIZE_CONFIDENCE_THRESHOLD=0.70
